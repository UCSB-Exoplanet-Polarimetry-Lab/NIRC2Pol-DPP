__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/
.DS_Store

# This branch carries the pipeline only. No science data
*.fits
*.fits.gz
*.png
*.jpg
*.jls
*.npy
*.npz

# ...except the static detector bad-pixel mask, which the pipeline needs
# in order to run,
!instruments/masks/*.fits

# ...and the tutorial dataset, which is deliberately bundled so the tutorial
# runs without access to the observatory archive. See
# examples/tutorial_data/README.md for what it is and why these frames.
!examples/tutorial_data/**
